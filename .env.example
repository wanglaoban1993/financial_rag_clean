# Copy this file to .env and change every secret before starting the stack.

TZ=Europe/Berlin

# Host path to the runtime config file (mounted read-only into containers).
# Recommended: /home/<user>/.config/financial_rag/config.yaml
FIN_RAG_CONFIG=/home/your-user/.config/financial_rag/config.yaml

# Optional. Fallback price source for the /history chart endpoint when
# yfinance is empty/rate-limited (same key as config.yaml's market.eodhd_api_key).
# Leave empty to skip the fallback and only use yfinance.
EODHD_API_KEY=

POSTGRES_DB=financial_rag
POSTGRES_USER=financial_user
POSTGRES_PASSWORD=change-me-long-random-password
POSTGRES_PORT=5432

API_PORT=8000
DASHBOARD_PORT=8501

# Automatic pg_dump backups run in the postgres-backup container.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > Install connector.
# Keep this empty until the Access app and tunnel are created in Cloudflare.
CLOUDFLARED_TUNNEL_TOKEN=
