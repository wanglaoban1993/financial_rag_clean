FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.topflop.txt .
RUN pip install --no-cache-dir -r requirements.topflop.txt

CMD ["bash", "scripts/run_finanzen_topflop_update.sh"]
