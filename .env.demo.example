# Copy to .env.demo and fill in real values before running the public demo stack.
# Keep separate from .env (which holds your personal-stack secrets).

TZ=Europe/Berlin

# Host path to the runtime config file (mounted read-only into containers).
# Keep this outside the repository.
FIN_RAG_CONFIG=/home/your-user/.config/financial_rag/config.yaml

POSTGRES_DB=financial_rag_demo
POSTGRES_USER=financial_demo_user
POSTGRES_PASSWORD=change-me-long-random-password

# Different host ports than the personal stack (5432/8000/8100/8501) so both
# can run at the same time on the same machine without colliding.
POSTGRES_PORT=5433
API_PORT=8001
AGENT_API_PORT=8101
DASHBOARD_PORT=8502

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# Abuse/cost protection for a publicly-linked demo (see docker-compose.demo.yml).
# DEMO_DAILY_MESSAGE_LIMIT: hard global cap on Assistant messages per day (0 = unlimited).
# DEMO_SESSION_MESSAGE_LIMIT: soft per-browser-session cap (0 = unlimited).
DEMO_DAILY_MESSAGE_LIMIT=200
DEMO_SESSION_MESSAGE_LIMIT=15

# Cloudflare Zero Trust > Networks > Tunnels > create tunnel > Docker connector > copy token.
# Then add a Public Hostname on that tunnel: demo.financial-rag.org -> HTTP -> dashboard:8501
CLOUDFLARED_TUNNEL_TOKEN=
